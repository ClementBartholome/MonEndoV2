# ---------------------------------------------------------------------------
# MonEndo - .gitignore unique pour tout le dépôt (serveur .NET + client Vue).
# Le dépôt est public : tout fichier contenant un secret doit être ignoré ici.
# ---------------------------------------------------------------------------

# Secrets et données d'exécution
.env
.env.*
!.env.example
MonEndoVue.Server/appsettings.json
MonEndoVue.Server/appsettings.*.json
**/serviceAccountKey.json
keys/
*.pfx
*.p12
*.pem
*.key

# Documents locaux non versionnés (audit sécurité, notes privées)
docs/private/

# OS / archives
.DS_Store
Thumbs.db
Desktop.ini
__MACOSX/
._*
/nul

# IDE
.vs/
.idea/
*.user
*.suo
*.rsuser
*.DotSettings.user
*.sw?
*.ntvs*
*.njsproj
**/.vscode/*
!**/.vscode/extensions.json

# .NET
[Bb]in/
[Oo]bj/
/packages/
*.nupkg
TestResults/
/out/
/publish/
.sonar/

# Node / Vite
node_modules/
/monendovue.client/dist/
/monendovue.client/dist-ssr/
/monendovue.client/dev-dist/
coverage/
*.tsbuildinfo
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
test-results/
playwright-report/
blob-report/
**/playwright/.cache/
**/playwright/.auth/

# Logs
*.log
[Ll]ogs/

# Outils locaux
.claude/settings.local.json
