{
  "extends": "../tsconfig.node.json",
  "include": ["./**/*", "../playwright.config.ts"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": null,
    "rootDir": "..",
    // DOM : les scripts passés à page.addInitScript / page.evaluate s'exécutent dans le navigateur.
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
